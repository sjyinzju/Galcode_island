# /etc/galcode-community.env 的样板
# systemd EnvironmentFile= 不解析引号，值不要加 ""

PORT=8787
DATA_DIR=/var/lib/galcode-community/data
UPLOADS_DIR=/var/lib/galcode-community/uploads
ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,https://community.example.com
MAX_UPLOAD_BYTES=8388608
DEFAULT_PAGE_SIZE=24
MAX_PAGE_SIZE=60
TOP_HOT_COUNT=10
