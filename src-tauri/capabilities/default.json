{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-set-badge-count",
    "core:window:allow-set-focus",
    "core:window:allow-is-focused",
    "core:window:allow-set-title",
    "core:window:allow-title",
    "core:event:default",
    "opener:default",
    "dialog:default",
    "updater:default",
    "process:default",
    "notification:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://gcbackend.haruyuki.cn/*" }
      ]
    },
    "allow-select-project-folder",
    "allow-list-directory",
    "allow-validate-directory",
    "allow-list-project-slash-commands",
    "allow-start-agent",
    "allow-stop-agent",
    "allow-respond-permission",
    "allow-respond-permission-decision",
    "allow-get-session-logs",
    "allow-list-sessions",
    "allow-scan-external-sessions",
    "allow-import-external-sessions",
    "allow-list-imported-conversations",
    "allow-load-imported-conversation",
    "allow-load-imported-asset",
    "allow-remove-imported-conversation",
    "allow-finalize-pending",
    "allow-translate-only",
    "allow-generate-welcome-speech",
    "allow-generate-poke-speech",
    "allow-set-click-through",
    "allow-update-llm-settings",
    "allow-update-backend-preferences",
    "allow-list-llm-models",
    "allow-claude-status",
    "allow-claude-models",
    "allow-claude-verify",
    "allow-claude-login-open",
    "allow-claude-run-in-terminal",
    "allow-claude-send-prompt",
    "allow-codex-status",
    "allow-codex-models",
    "allow-codex-verify",
    "allow-codex-login-open",
    "allow-codex-send-prompt",
    "allow-opencode-status",
    "allow-opencode-start",
    "allow-opencode-stop",
    "allow-opencode-create-session",
    "allow-opencode-send-prompt",
    "allow-opencode-set-auth",
    "allow-opencode-login-open",
    "allow-opencode-list-providers",
    "allow-lan-get-state",
    "allow-lan-set-password",
    "allow-lan-clear-password",
    "allow-lan-set-port",
    "allow-lan-set-enabled",
    "allow-lan-revoke-all-devices",
    "allow-lan-sync-projects",
    "allow-lan-list-storage",
    "allow-lan-get-storage",
    "allow-lan-set-storage",
    "allow-lan-remove-storage",
    "allow-git-status",
    "allow-git-diff",
    "allow-git-stage",
    "allow-git-unstage",
    "allow-git-commit",
    "allow-git-push",
    "allow-git-pull",
    "allow-git-discard",
    "allow-git-log",
    "allow-git-show-commit-files",
    "allow-git-show-file-diff",
    "allow-git-generate-commit-message",
    "allow-git-list-branches",
    "allow-git-checkout-branch",
    "allow-git-remote-url",
    "allow-git-pushed-commits",
    "allow-pet-configure",
    "allow-pet-update-snapshot",
    "allow-pet-input",
    "allow-set-pet-click-through"
  ]
}
