{
  "name": "galcode_island",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-tauri.mjs dev",
    "dev:web": "vite",
    "prebuild": "npm run prepare:runtime",
    "build": "node scripts/run-tauri.mjs build",
    "build:web": "vite build",
    "preview": "vite preview",
    "tauri": "node scripts/run-tauri.mjs",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:rust": "node scripts/run-cargo.mjs check",
    "fmt:rust": "node scripts/run-cargo.mjs fmt",
    "lint:rust": "node scripts/run-cargo.mjs clippy --all-targets -- -D warnings",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "release": "node scripts/release.mjs",
    "release:dry-run": "node scripts/release.mjs --dry-run",
    "release:build:macos": "node scripts/prepare-runtime.mjs --sign && tauri build --target aarch64-apple-darwin --bundles app && node scripts/fix-bundle-signatures.mjs && node scripts/package-and-notarize.mjs",
    "release:build:windows": "node scripts/prepare-runtime.mjs && tauri build --bundles nsis && node scripts/package-windows-updater.mjs",
    "clean": "node -e \"const fs=require('node:fs');for(const p of ['dist','src-tauri/target','src-tauri/resources/runtime']){fs.rmSync(p,{recursive:true,force:true})}\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-virtual": "^3.13.24",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "framer-motion": "^12.38.0",
    "pixi-live2d-display": "^0.5.0-beta",
    "pixi.js": "^7.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.2",
    "tailwindcss": "^4.2.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.6"
  }
}
